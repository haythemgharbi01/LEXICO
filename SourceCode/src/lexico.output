Grammar

    0 $accept: program $end

    1 program: ε
    2        | stmt_list

    3 stmt_list: stmt
    4          | stmt_list stmt

    5 stmt: decl_stmt ';'
    6     | collection_decl_stmt ';'
    7     | collection_set_stmt ';'
    8     | append_stmt ';'
    9     | sort_stmt ';'
   10     | print_stmt ';'
   11     | set_stmt ';'
   12     | convert_stmt ';'
   13     | emit_stmt ';'
   14     | giveback_stmt ';'
   15     | compound_stmt ';'
   16     | function_stmt
   17     | class_stmt
   18     | file_open_stmt
   19     | file_stmt ';'
   20     | if_stmt
   21     | while_stmt
   22     | for_stmt
   23     | repeat_stmt
   24     | attempt_stmt

   25 file_open_stmt: OPEN expr FILE_T DO block
   26               | OPEN expr FILE_T MAKE DO block

   27 file_stmt: WRITE expr IN FILE_T
   28          | WRITE expr IN LINE expr IN FILE_T
   29          | READ FILE_T INTO IDENT
   30          | READ LINE expr IN FILE_T INTO IDENT
   31          | READ expr LINES IN FILE_T INTO IDENT
   32          | READ expr LINES FROM LINE expr IN FILE_T INTO IDENT
   33          | CLEAR FILE_T
   34          | CLEAR LINE expr IN FILE_T
   35          | CLEAR FROM LINE expr TO LINE expr IN FILE_T
   36          | SET FILE_T TITLE TO expr
   37          | CLOSE FILE_T

   38 collection_decl_stmt: CREATE ARRAY OF type IDENT WITH SIZE expr
   39                     | CREATE TABLE IDENT WITH SIZE expr
   40                     | CREATE type MESH IDENT SIZED expr
   41                     | CREATE type MESH IDENT SET VALUES mesh_init_values
   42                     | CREATE MESH IDENT SIZED expr
   43                     | CREATE MESH IDENT SET VALUES mesh_init_values
   44                     | CREATE type MATRIX MESH IDENT ROWS expr COLS expr
   45                     | CREATE type MATRIX MESH IDENT SET VALUES matrix_init_rows
   46                     | CREATE type MATRIX MESH IDENT SET VALUE matrix_init_rows
   47                     | CREATE MATRIX MESH IDENT ROWS expr COLS expr
   48                     | CREATE MATRIX MESH IDENT SET VALUES matrix_init_rows
   49                     | CREATE MATRIX MESH IDENT SET VALUE matrix_init_rows
   50                     | CREATE type MATRIX IDENT ROWS expr COLS expr

   51 collection_set_stmt: SET IDENT AT expr TO expr
   52                    | SET IDENT VALUE AT expr TO expr
   53                    | SET IDENT AT expr ',' expr TO expr
   54                    | SET IDENT VALUE AT expr ',' expr TO expr
   55                    | SET expr TO IDENT AT expr ',' expr
   56                    | SET expr AT expr ',' expr
   57                    | SET IDENT AT expr TO TAKE USER INPUT opt_message
   58                    | SET IDENT VALUE AT expr TO TAKE USER INPUT opt_message
   59                    | SET VALUE AT expr TO expr
   60                    | SET VALUE TO expr
   61                    | SET VALUE AT expr TO TAKE USER INPUT opt_message
   62                    | SET VALUE TO TAKE USER INPUT opt_message

   63 append_stmt: APPEND append_value TO IDENT
   64            | APPEND append_value TO IDENT AT expr
   65            | APPEND append_value
   66            | APPEND append_value AT expr

   67 sort_stmt: SORT IDENT ASCENDANTLY
   68          | SORT IDENT DESCENDANTLY

   69 append_value: append_value PLUS append_term
   70             | append_value MINUS append_term
   71             | append_term

   72 append_term: append_term TIMES append_factor
   73            | append_term DIV append_factor
   74            | append_term MOD append_factor
   75            | append_factor

   76 append_factor: call_expr
   77              | SIZE OF IDENT
   78              | ROW LENGTH OF IDENT
   79              | COLUMN LENGTH OF IDENT
   80              | LENGTH OF append_factor
   81              | EXTRACT append_value FROM IDENT
   82              | EXTRACT FROM append_value TO append_value IN IDENT
   83              | COUNT append_value IN IDENT
   84              | CHECK append_value IN IDENT
   85              | POSITION OF append_value IN IDENT
   86              | IDENT
   87              | literal
   88              | '(' append_value ')'
   89              | MINUS append_factor
   90              | PLUS append_factor

   91 function_stmt: DEFINE ROUTINE IDENT opt_param_clause RETURNS type DO block

   92 opt_param_clause: ε
   93                 | WITH ARGS IN TAKE param_list

   94 param_list: type IDENT
   95           | param_list ',' type IDENT

   96 emit_stmt: EMIT IDENT opt_call_args

   97 giveback_stmt: GIVEBACK expr

   98 opt_call_args: ε
   99              | WITH ARGS IN TAKE simple_call_args
  100              | WITH ARGS IN TAKE '(' call_args ')'

  101 simple_call_args: call_arg_simple
  102                 | simple_call_args ',' call_arg_simple

  103 call_arg_simple: IDENT
  104                | literal
  105                | call_expr
  106                | '(' expr ')'
  107                | MINUS call_arg_simple
  108                | PLUS call_arg_simple

  109 call_args: expr
  110          | call_args ',' expr

  111 call_expr: OUTCOME OF IDENT opt_call_args

  112 decl_stmt: CREATE IDENT IDENT USING IDENT
  113          | CREATE type IDENT SET VALUE expr
  114          | CREATE type id_list_multi SET VALUE val_list_multi
  115          | CREATE type IDENT
  116          | CREATE type id_list_multi
  117          | CREATE type IDENT SET_VALUE_TAKE_USER_INPUT opt_message

  118 $@1: ε

  119 class_stmt: DEFINE CLASS IDENT INCLUDE $@1 INDENT class_body DEDENT

  120 $@2: ε

  121 class_stmt: DEFINE CLASS IDENT INHERITS IDENT INCLUDE $@2 INDENT class_body DEDENT

  122 class_body: class_member
  123           | class_body class_member

  124 class_member: CREATE type IDENT ';'
  125             | OVERRIDE CREATE type IDENT ';'

  126 $@3: ε

  127 class_member: PROFILE IDENT DO $@3 INDENT profile_body DEDENT
  128             | ROUTINE IDENT opt_param_clause RETURNS type DO block
  129             | ROUTINE IDENT opt_param_clause DO block
  130             | OVERRIDE ROUTINE IDENT opt_param_clause RETURNS type DO block
  131             | OVERRIDE ROUTINE IDENT opt_param_clause DO block

  132 profile_body: profile_line
  133             | profile_body profile_line

  134 profile_line: SET IDENT TO expr ';'
  135             | SET IDENT TO TAKE USER INPUT opt_message ';'

  136 opt_message: ε
  137            | WITH MESSAGE message_parts

  138 message_parts: expr
  139              | message_parts ',' expr

  140 print_stmt: PRINT print_args

  141 if_stmt: IF condition THEN block
  142        | IF condition THEN block else_part

  143 else_part: OTHERWISE block
  144          | OTHERWISE WHEN condition THEN block
  145          | OTHERWISE WHEN condition THEN block else_part

  146 block: INDENT block_body DEDENT

  147 block_body: stmt
  148           | block_body stmt

  149 while_stmt: WHILE condition DO block

  150 for_stmt: FOR IDENT FROM expr TO expr opt_step DO block
  151         | FOR IDENT IN IDENT FROM expr TO expr opt_step DO block
  152         | FOR IDENT IDENT IN IDENT IDENT FROM expr TO expr AND IDENT FROM expr TO expr DO block

  153 opt_step: ε
  154         | STEP expr

  155 repeat_stmt: REPEAT block UNTIL condition THEN

  156 attempt_stmt: ATTEMPT UPTO expr WHILE condition DO block opt_onfailure
  157             | ATTEMPT UPTO expr TIMES_WHILE condition DO block opt_onfailure

  158 opt_onfailure: ε
  159              | ONFAILURE block

  160 condition: cond_or

  161 cond_or: cond_or OR cond_and
  162        | cond_and

  163 cond_and: cond_and AND cond_not
  164         | cond_not

  165 cond_not: NOT cond_atom
  166         | cond_atom

  167 cond_atom: expr CMP_EQ expr
  168          | expr CMP_NEQ expr
  169          | expr CMP_GT expr
  170          | expr CMP_LT expr
  171          | expr CMP_GTE expr
  172          | expr CMP_LTE expr
  173          | '(' condition ')'

  174 type: T_INT
  175     | T_FLOAT
  176     | T_CHAR
  177     | T_STRING
  178     | T_BOOL

  179 id_list_multi: IDENT ',' IDENT
  180              | id_list_multi ',' IDENT

  181 val_list_multi: expr ',' expr
  182               | val_list_multi ',' expr

  183 mesh_init_values: expr
  184                 | mesh_init_values ',' expr

  185 matrix_init_row: expr
  186                | matrix_init_row ',' expr

  187 matrix_init_rows: matrix_init_row
  188                 | matrix_init_rows '/' matrix_init_row

  189 print_args: expr
  190           | print_args ',' expr

  191 compound_stmt: IDENT PLUS expr
  192              | IDENT MINUS expr
  193              | IDENT TIMES expr
  194              | IDENT DIV expr
  195              | IDENT MOD expr

  196 set_stmt: SET IDENT TO expr
  197         | SET IDENT AT expr ',' expr
  198         | SET IDENT TO TAKE USER INPUT opt_message

  199 convert_stmt: CONVERT IDENT TO type

  200 expr: expr PLUS term
  201     | expr MINUS term
  202     | term

  203 term: term TIMES factor
  204     | term DIV factor
  205     | term MOD factor
  206     | factor

  207 factor: call_expr
  208       | CONVERT expr TO type
  209       | IDENT AT factor ',' factor
  210       | SIZE OF IDENT
  211       | ROW LENGTH OF IDENT
  212       | COLUMN LENGTH OF IDENT
  213       | LENGTH OF factor
  214       | EXTRACT expr FROM IDENT
  215       | EXTRACT FROM expr TO expr IN IDENT
  216       | COUNT expr IN IDENT
  217       | CHECK expr IN IDENT
  218       | POSITION OF expr IN IDENT
  219       | IDENT AT factor
  220       | IDENT
  221       | literal
  222       | '(' expr ')'
  223       | MINUS factor
  224       | PLUS factor

  225 literal: INT_LIT
  226        | FLOAT_LIT
  227        | CHAR_LIT
  228        | STRING_LIT
  229        | TRUE
  230        | FALSE


